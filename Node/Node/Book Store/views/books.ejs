<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Explore Books | Bookstore</title>

  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,600;0,8..60,700;0,8..60,800&display=swap" rel="stylesheet">

  <style>
    :root {
      --brand-blue: #2563eb;
      --brand-blue-hover: #1d4ed8;
      --font-serif: 'Source Serif 4', Georgia, serif;
      --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    }

    body {
      font-family: var(--font-sans);
    }

    .serif-title {
      font-family: var(--font-serif);
    }

    .site-header {
      background-color: var(--brand-blue);
      color: #ffffff;
      padding: 16px 36px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 50;
      box-shadow: 0 2px 10px rgba(37, 99, 235, 0.15);
    }

    .site-logo {
      font-size: 1.4rem;
      font-weight: 800;
      color: #ffffff;
      text-decoration: none;
      letter-spacing: -0.01em;
    }

    .site-nav {
      display: flex;
      gap: 24px;
      align-items: center;
    }

    .site-nav a {
      color: rgba(255, 255, 255, 0.9);
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 600;
      transition: color 0.15s ease;
    }

    .site-nav a:hover,
    .site-nav a.active {
      color: #ffffff;
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    .site-footer {
      background-color: var(--brand-blue);
      color: #ffffff;
      padding: 24px 36px 18px;
      margin-top: auto;
    }

    .footer-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
    }

    .footer-brand {
      font-size: 1.3rem;
      font-weight: 800;
    }

    .footer-links a {
      color: #ffffff;
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 600;
      transition: opacity 0.15s;
    }

    .footer-links a:hover {
      opacity: 0.8;
    }

    .footer-copy {
      text-align: center;
      font-size: 0.82rem;
      color: rgba(255, 255, 255, 0.8);
      border-top: 1px solid rgba(255, 255, 255, 0.18);
      padding-top: 14px;
    }
  </style>
</head>

<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

  <header class="site-header">
    <a href="/" class="site-logo">Bookstore</a>
    <nav class="site-nav">
      <a href="/">Home</a>
      <a href="/books" class="active">Books</a>
      <a href="/category">Categories</a>
      <a href="/cart">Cart</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a href="/admin">Admin</a>
    </nav>
  </header>

  <main class="max-w-7xl mx-auto px-5 py-12 flex-1 w-full">


    <div class="mb-10 text-center md:text-left">
      <span class="inline-block text-blue-600 font-bold uppercase tracking-wider text-xs bg-blue-50 border border-blue-100 px-3.5 py-1 rounded-full mb-3">
        Our Collection
      </span>
      <h1 class="serif-title text-3xl md:text-4xl font-bold text-slate-900">
        Explore Books
      </h1>
      <p class="text-slate-500 mt-2 text-base">
        Browse and discover stories, ideas, and timeless wisdom from our curated shelf.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-7">

    <% books.forEach(book => { %>

        <div class="bg-white rounded-2xl overflow-hidden border border-slate-200/80 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 flex flex-col">

          <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
            <a href="/books/edit/<%= book._id %>" class="block">
              <div class="h-72 bg-slate-100/70 flex items-center justify-center p-5 overflow-hidden">
                <img
                  src="/<%= book.image %>"
                  alt="<%= book.name || book.title || 'Book image' %>"
                  class="h-full w-auto max-w-full object-contain rounded-md shadow-sm transition-transform duration-300 hover:scale-105"
                >
              </div>
            </a>
          <% } else { %>
            <div class="h-72 bg-slate-100/70 flex items-center justify-center p-5 overflow-hidden">
              <img
                src="/<%= book.image %>"
                alt="<%= book.name || book.title || 'Book image' %>"
                class="h-full w-auto max-w-full object-contain rounded-md shadow-sm transition-transform duration-300 hover:scale-105"
              >
            </div>
          <% } %>

          <div class="p-5 flex-1 flex flex-col justify-between">
            <div>
              <span class="inline-block bg-blue-50 text-blue-600 text-xs font-semibold px-3 py-1 rounded-full mb-3">
                <%= book.category %>
              </span>

              <h2 class="text-lg font-bold text-slate-900 mb-2 line-clamp-1" title="<%= book.name %>">
                <%= book.name %>
              </h2>
            </div>

            <div>
              <div class="flex items-center justify-between my-4 pt-2 border-t border-slate-100">
                <div>
                  <p class="text-xs text-slate-400 font-medium">Price</p>
                  <p class="text-2xl font-extrabold text-blue-600">
                    ₹<%= book.price %>
                  </p>
                </div>
              </div>

              <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                <a href="/books/edit/<%= book._id %>"
                   class="flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-xl text-sm font-semibold text-amber-800 bg-amber-50 border border-amber-200 hover:bg-amber-100 hover:border-amber-300 transition shadow-xs">
                  <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                  </svg>
                  <span>Edit Book Details</span>
                </a>
              <% } else { %>
                <a href="/books/add-to-cart/<%= book._id %>"
                   class="group relative flex items-center justify-center gap-2.5 w-full py-3 px-5 rounded-xl text-sm font-semibold text-white bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 shadow-md shadow-blue-500/20 hover:shadow-lg hover:shadow-blue-500/35 active:scale-[0.98] transition-all duration-200">
                  <svg class="w-4 h-4 transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:rotate-[-6deg]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                  </svg>
                  <span>Add to Cart</span>
                </a>
              <% } %>
            </div>
          </div>

        </div>

      <% }) %>

    </div>

  </main>

  <footer class="site-footer">
    <div class="footer-top">
      <span class="footer-brand">Bookstore</span>
      <div class="footer-links">
        <a href="mailto:support@bookstore.com">Email</a>
      </div>
    </div>
    <div class="footer-copy">
      &copy; 2026 Bookstore. All Rights Reserved.
    </div>
  </footer>

</body>
</html>