<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shopping Cart | Bookstore</title>

  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,600;0,8..60,700;0,8..60,800&display=swap" rel="stylesheet">

  <style>
    :root {
      --brand-blue: #2563eb;
      --brand-blue-hover: #1d4ed8;
      --font-serif: 'Source Serif 4', Georgia, serif;
      --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    }

    body {
      font-family: var(--font-sans);
    }

    .serif-title {
      font-family: var(--font-serif);
    }

    .site-header {
      background-color: var(--brand-blue);
      color: #ffffff;
      padding: 16px 36px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 50;
      box-shadow: 0 2px 10px rgba(37, 99, 235, 0.15);
    }

    .site-logo {
      font-size: 1.4rem;
      font-weight: 800;
      color: #ffffff;
      text-decoration: none;
      letter-spacing: -0.01em;
    }

    .site-nav {
      display: flex;
      gap: 24px;
      align-items: center;
    }

    .site-nav a {
      color: rgba(255, 255, 255, 0.9);
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 600;
      transition: color 0.15s ease;
    }

    .site-nav a:hover,
    .site-nav a.active {
      color: #ffffff;
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    .site-footer {
      background-color: var(--brand-blue);
      color: #ffffff;
      padding: 24px 36px 18px;
      margin-top: auto;
    }

    .footer-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
    }

    .footer-brand {
      font-size: 1.3rem;
      font-weight: 800;
    }

    .footer-links a {
      color: #ffffff;
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 600;
      transition: opacity 0.15s;
    }

    .footer-links a:hover {
      opacity: 0.8;
    }

    .footer-copy {
      text-align: center;
      font-size: 0.82rem;
      color: rgba(255, 255, 255, 0.8);
      border-top: 1px solid rgba(255, 255, 255, 0.18);
      padding-top: 14px;
    }
  </style>
</head>

<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

  <header class="site-header">
    <a href="/" class="site-logo">Bookstore</a>
    <nav class="site-nav">
      <a href="/">Home</a>
      <a href="/books">Books</a>
      <a href="/category">Categories</a>
      <a href="/cart" class="active">Cart</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a href="/admin">Admin</a>
    </nav>
  </header>

  <main class="max-w-5xl mx-auto px-5 py-12 flex-1 w-full">

    <div class="mb-8">
      <span class="inline-block text-blue-600 font-bold uppercase tracking-wider text-xs bg-blue-50 border border-blue-100 px-3.5 py-1 rounded-full mb-3">
        Your Order
      </span>
      <h1 class="serif-title text-3xl md:text-4xl font-bold text-slate-900">
        Shopping Cart
      </h1>
      <p class="text-slate-500 mt-1 text-sm">
        Review your selected books before checking out.
      </p>
    </div>

    <% if (!cartItems || cartItems.length === 0) { %>
      <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-12 text-center max-w-lg mx-auto">
        <div class="w-16 h-16 bg-blue-50 text-blue-600 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-4">
          🛒
        </div>
        <h2 class="serif-title text-2xl font-bold text-slate-900 mb-2">Your cart is empty</h2>
        <p class="text-slate-500 text-sm mb-6">Looks like you haven't added any books to your cart yet.</p>
        <a href="/books" class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-6 rounded-full text-sm transition shadow-sm hover:shadow-md">
          Explore Books →
        </a>
      </div>
    <% } else { %>
      <div class="space-y-4">
        <% cartItems.forEach(item => { %>
          <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-5 flex flex-col md:flex-row justify-between items-center gap-5 hover:border-slate-300 transition-all">
            
            <div class="flex items-center gap-5 w-full md:w-auto">
              <img src="/<%= item.image %>" 
                   alt="<%= item.name || item.title %>" 
                   class="w-20 h-24 object-contain rounded-xl bg-slate-50 border border-slate-100 p-1 flex-shrink-0">
              
              <div class="min-w-0">
                <span class="inline-block text-[11px] font-semibold uppercase tracking-wider text-blue-600 bg-blue-50 px-2.5 py-0.5 rounded-full mb-1">
                  <%= item.category || 'Book' %>
                </span>
                <h2 class="text-lg font-bold text-slate-900 truncate" title="<%= item.name || item.title %>">
                  <%= item.name || item.title %>
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">Quantity: <strong class="text-slate-800"><%= item.quantity %></strong></p>
              </div>
            </div>

            <div class="flex items-center justify-between md:justify-end gap-6 w-full md:w-auto pt-3 md:pt-0 border-t md:border-t-0 border-slate-100">
              <div class="text-left md:text-right">
                <p class="text-xs text-slate-400 font-medium">₹<%= item.price %> each</p>
                <p class="text-lg font-extrabold text-blue-600">
                  ₹<%= Number(item.price) * Number(item.quantity || 1) %>
                </p>
              </div>

              <div class="flex items-center gap-2">
                <a href="/cart/decrease/<%= item._id %>" 
                   title="Decrease quantity"
                   class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold w-9 h-9 rounded-xl flex items-center justify-center text-sm transition">
                  -1
                </a>
                <a href="/cart/remove/<%= item._id %>" 
                   class="border border-rose-200 hover:bg-rose-50 text-rose-600 font-semibold py-2 px-3.5 rounded-xl text-xs transition">
                  Remove
                </a>
              </div>
            </div>

          </div>
        <% }) %>
      </div>

      <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6 mt-8 flex flex-col md:flex-row justify-between items-center gap-5">
        <div>
          <p class="text-xs uppercase tracking-wider font-bold text-slate-400">Total Order Amount</p>
          <h2 class="serif-title text-3xl font-extrabold text-slate-900 mt-0.5">₹<%= total %></h2>
        </div>

        <div class="flex items-center gap-3 w-full md:w-auto">
          <a href="/books" class="flex-1 md:flex-none text-center bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold py-2.5 px-5 rounded-full text-sm transition">
            Keep Shopping
          </a>
          <a href="/contact" class="flex-1 md:flex-none text-center bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-6 rounded-full text-sm transition shadow-sm hover:shadow-md">
            Proceed to Checkout →
          </a>
        </div>
      </div>
    <% } %>

  </main>

  <footer class="site-footer">
    <div class="footer-top">
      <span class="footer-brand">Bookstore</span>
      <div class="footer-links">
        <a href="mailto:support@bookstore.com">Email</a>
      </div>
    </div>
    <div class="footer-copy">
      &copy; 2026 Bookstore. All Rights Reserved.
    </div>
  </footer>

</body>
</html>