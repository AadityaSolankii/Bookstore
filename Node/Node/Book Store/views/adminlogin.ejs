<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login | Bookstore</title>

  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,600;0,8..60,700;0,8..60,800&display=swap" rel="stylesheet">

  <style>
    :root {
      --brand-blue: #2563eb;
      --brand-blue-hover: #1d4ed8;
      --font-serif: 'Source Serif 4', Georgia, serif;
      --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    }

    body {
      font-family: var(--font-sans);
    }

    .serif-title {
      font-family: var(--font-serif);
    }

    .site-header {
      background-color: var(--brand-blue);
      color: #ffffff;
      padding: 16px 36px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 50;
      box-shadow: 0 2px 10px rgba(37, 99, 235, 0.15);
    }

    .site-logo {
      font-size: 1.4rem;
      font-weight: 800;
      color: #ffffff;
      text-decoration: none;
      letter-spacing: -0.01em;
    }

    .site-nav {
      display: flex;
      gap: 24px;
      align-items: center;
    }

    .site-nav a {
      color: rgba(255, 255, 255, 0.9);
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 600;
      transition: color 0.15s ease;
    }

    .site-nav a:hover,
    .site-nav a.active {
      color: #ffffff;
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    .site-footer {
      background-color: var(--brand-blue);
      color: #ffffff;
      padding: 24px 36px 18px;
      margin-top: auto;
    }

    .footer-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
    }

    .footer-brand {
      font-size: 1.3rem;
      font-weight: 800;
    }

    .footer-links a {
      color: #ffffff;
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 600;
      transition: opacity 0.15s;
    }

    .footer-links a:hover {
      opacity: 0.8;
    }

    .footer-copy {
      text-align: center;
      font-size: 0.82rem;
      color: rgba(255, 255, 255, 0.8);
      border-top: 1px solid rgba(255, 255, 255, 0.18);
      padding-top: 14px;
    }
  </style>
</head>

<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

  <header class="site-header">
    <a href="/" class="site-logo">Bookstore</a>
    <nav class="site-nav">
      <a href="/">Home</a>
      <a href="/books">Books</a>
      <a href="/category">Categories</a>
      <a href="/cart">Cart</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a href="/admin" class="active">Admin</a>
    </nav>
  </header>

  <main class="max-w-md mx-auto my-14 px-5 flex-1 w-full flex items-center justify-center">

    <div class="bg-white rounded-3xl p-8 md:p-10 border border-slate-200/80 shadow-xs w-full">
      
      <div class="text-center mb-8">
        <span class="inline-block text-blue-600 font-bold uppercase tracking-wider text-xs bg-blue-50 border border-blue-100 px-3.5 py-1 rounded-full mb-3">
          Restricted Area
        </span>
        <h1 class="serif-title text-3xl font-bold text-slate-900">Admin Login</h1>
        <p class="text-slate-500 text-sm mt-1.5">Sign in to manage inventory & settings.</p>
      </div>

      <% if (error) { %>
        <div class="mb-5 p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-sm font-semibold flex items-center gap-2">
          <span>⚠️</span>
          <span><%= error %></span>
        </div>
      <% } %>

      <form action="/admin/login" method="POST" class="space-y-5">
        <div>
          <label for="username" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">Username</label>
          <input 
            id="username" 
            type="text" 
            name="username" 
            autocomplete="username" 
            required
            placeholder="Enter admin username"
            class="w-full px-4 py-3 bg-slate-50/50 border border-slate-200 rounded-xl text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition"
          >
        </div>

        <div>
          <label for="password" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">Password</label>
          <input 
            id="password" 
            type="password" 
            name="password" 
            autocomplete="current-password" 
            required
            placeholder="••••••••"
            class="w-full px-4 py-3 bg-slate-50/50 border border-slate-200 rounded-xl text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition"
          >
        </div>

        <button 
          type="submit" 
          class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-full text-sm transition shadow-sm hover:shadow-md cursor-pointer mt-2"
        >
          Sign In →
        </button>
      </form>

    </div>

  </main>

  <footer class="site-footer">
    <div class="footer-top">
      <span class="footer-brand">Bookstore</span>
      <div class="footer-links">
        <a href="mailto:support@bookstore.com">Email</a>
      </div>
    </div>
    <div class="footer-copy">
      &copy; 2026 Bookstore. All Rights Reserved.
    </div>
  </footer>

</body>
</html>