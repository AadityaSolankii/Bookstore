<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Bookstore | Read More, Live Better</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap"
    rel="stylesheet"
  >

  <style>
    :root {
      --blue: #2563eb;
      --blue-dark: #1d4ed8;
      --blue-light: #eff6ff;
      --navy: #0f172a;
      --muted: #64748b;
      --cream: #fffdf8;
      --white: #ffffff;
      --border: #e5e7eb;
      --green: #10b981;
      --orange: #f59e0b;

      --serif: "Playfair Display", Georgia, serif;
      --sans: "DM Sans", system-ui, sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: var(--sans);
      background: var(--cream);
      color: var(--navy);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    /* =====================================================
       HEADER - KEPT SAME STYLE
    ===================================================== */

    .site-header {
      background-color: var(--blue);
      color: #ffffff;
      padding: 16px 36px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 50;
      box-shadow: 0 2px 10px rgba(37, 99, 235, 0.15);
    }

    .site-logo {
      font-size: 1.4rem;
      font-weight: 800;
      color: #ffffff;
      text-decoration: none;
      letter-spacing: -0.01em;
    }

    .site-nav {
      display: flex;
      gap: 24px;
      align-items: center;
    }

    .site-nav a {
      color: rgba(255, 255, 255, 0.9);
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 600;
      transition: color 0.15s ease;
    }

    .site-nav a:hover,
    .site-nav a.active {
      color: #ffffff;
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    /* =====================================================
       MAIN
    ===================================================== */

    .home-content {
      flex: 1;
      width: 100%;
      overflow: hidden;
    }

    .content-wrap {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* =====================================================
       HERO
    ===================================================== */

    .hero-section {
      min-height: 620px;
      padding: 75px 0 90px;
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: 65px;
      align-items: center;
      position: relative;
    }

    .hero-section::before {
      content: "";
      position: absolute;
      width: 420px;
      height: 420px;
      background: #dbeafe;
      border-radius: 50%;
      filter: blur(90px);
      opacity: 0.55;
      right: -180px;
      top: -100px;
      z-index: -1;
    }

    .hero-section::after {
      content: "";
      position: absolute;
      width: 280px;
      height: 280px;
      background: #fef3c7;
      border-radius: 50%;
      filter: blur(80px);
      opacity: 0.45;
      left: -150px;
      bottom: -80px;
      z-index: -1;
    }

    .hero-text-side {
      animation: fadeUp 0.7s ease both;
    }

    .badge-pill {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--blue);
      background: var(--blue-light);
      border: 1px solid #dbeafe;
      padding: 8px 15px;
      border-radius: 999px;
      margin-bottom: 22px;
    }

    .badge-pill::before {
      content: "✦";
      font-size: 0.8rem;
    }

    .hero-title {
      font-family: var(--serif);
      font-size: clamp(3rem, 5vw, 4.4rem);
      font-weight: 800;
      line-height: 1.06;
      letter-spacing: -0.035em;
      margin-bottom: 22px;
      color: var(--navy);
    }

    .hero-title span {
      color: var(--blue);
      position: relative;
    }

    .hero-title span::after {
      content: "";
      position: absolute;
      left: 2px;
      bottom: -5px;
      width: 100%;
      height: 6px;
      background: #bfdbfe;
      border-radius: 10px;
      z-index: -1;
    }

    .hero-description {
      font-size: 1.05rem;
      line-height: 1.75;
      color: var(--muted);
      max-width: 510px;
      margin-bottom: 34px;
    }

    .hero-actions {
      display: flex;
      gap: 14px;
      align-items: center;
    }

    .btn-primary {
      background: var(--blue);
      color: #ffffff;
      font-weight: 700;
      font-size: 0.95rem;
      padding: 14px 27px;
      border-radius: 12px;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.25s ease;
      box-shadow: 0 12px 25px rgba(37, 99, 235, 0.25);
    }

    .btn-primary:hover {
      background: var(--blue-dark);
      transform: translateY(-3px);
      box-shadow: 0 16px 30px rgba(37, 99, 235, 0.3);
    }

    .btn-outline {
      background: rgba(255, 255, 255, 0.8);
      color: var(--navy);
      font-weight: 700;
      font-size: 0.95rem;
      padding: 13px 27px;
      border-radius: 12px;
      text-decoration: none;
      border: 1px solid var(--border);
      transition: all 0.25s ease;
    }

    .btn-outline:hover {
      background: #ffffff;
      border-color: #bfdbfe;
      transform: translateY(-2px);
    }

    /* =====================================================
       HERO IMAGE
    ===================================================== */

    .hero-media {
      position: relative;
      animation: fadeUp 0.8s 0.1s ease both;
    }

    .hero-img {
      width: 100%;
      height: 440px;
      border-radius: 28px;
      object-fit: cover;
      display: block;
      box-shadow:
        0 30px 60px rgba(15, 23, 42, 0.14),
        0 8px 20px rgba(15, 23, 42, 0.06);
    }

    .hero-media::before {
      content: "";
      position: absolute;
      width: 100%;
      height: 100%;
      border: 2px solid #bfdbfe;
      border-radius: 28px;
      top: 14px;
      left: 14px;
      z-index: -1;
    }

    .floating-glass-card {
      position: absolute;
      bottom: 24px;
      left: -20px;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(14px);
      border: 1px solid rgba(255, 255, 255, 0.8);
      border-radius: 16px;
      padding: 15px 20px;
      box-shadow: 0 15px 35px rgba(15, 23, 42, 0.14);
    }

    .floating-glass-card .glass-tag {
      font-size: 0.67rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--blue);
      margin-bottom: 3px;
    }

    .floating-glass-card .glass-text {
      font-family: var(--serif);
      font-size: 1.05rem;
      font-weight: 700;
      margin: 0;
      color: var(--navy);
    }

    /* =====================================================
       SECTION HEADERS
    ===================================================== */

    .section-header {
      text-align: center;
      margin-bottom: 38px;
    }

    .section-title {
      font-family: var(--serif);
      font-size: 2.4rem;
      font-weight: 800;
      color: var(--navy);
      margin-bottom: 8px;
    }

    .section-subtitle {
      font-size: 0.96rem;
      color: var(--muted);
    }

    /* =====================================================
       CATEGORIES
    ===================================================== */

    .category-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-bottom: 90px;
    }

    .category-item {
      background: rgba(255, 255, 255, 0.85);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 25px;
      text-decoration: none;
      color: inherit;
      display: flex;
      align-items: center;
      gap: 17px;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 4px 15px rgba(15, 23, 42, 0.035);
    }

    .category-item:hover {
      transform: translateY(-7px);
      border-color: #bfdbfe;
      box-shadow: 0 20px 35px rgba(15, 23, 42, 0.09);
    }

    .cat-icon-wrap {
      width: 56px;
      height: 56px;
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      flex-shrink: 0;
      transition: transform 0.3s ease;
    }

    .category-item:hover .cat-icon-wrap {
      transform: scale(1.08) rotate(-4deg);
    }

    .cat-icon-wrap.blue {
      background: #eff6ff;
    }

    .cat-icon-wrap.green {
      background: #ecfdf5;
    }

    .cat-icon-wrap.amber {
      background: #fff7ed;
    }

    .cat-details {
      flex-grow: 1;
    }

    .cat-details h4 {
      font-size: 1rem;
      font-weight: 800;
      margin-bottom: 4px;
    }

    .cat-details p {
      font-size: 0.83rem;
      color: var(--muted);
      line-height: 1.4;
    }

    .cat-arrow-icon {
      color: var(--blue);
      font-size: 1.2rem;
      transition: transform 0.25s ease;
    }

    .category-item:hover .cat-arrow-icon {
      transform: translateX(6px);
    }

    /* =====================================================
       EXCHANGE SECTION
    ===================================================== */

    .exchange-block {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 28px;
      align-items: stretch;
      margin-bottom: 80px;
    }

    .exchange-banner-card {
      background: linear-gradient(145deg, #eff6ff, #ffffff);
      border: 1px solid #dbeafe;
      border-radius: 26px;
      padding: 38px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-shadow: 0 12px 30px rgba(37, 99, 235, 0.06);
    }

    .exchange-tag-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--blue);
      background: #dbeafe;
      padding: 7px 13px;
      border-radius: 999px;
      width: fit-content;
      margin-bottom: 17px;
    }

    .exchange-banner-card h3 {
      font-family: var(--serif);
      font-size: 2.3rem;
      font-weight: 800;
      line-height: 1.15;
      margin-bottom: 13px;
      color: var(--navy);
    }

    .exchange-banner-card > div > p {
      font-size: 0.94rem;
      color: var(--muted);
      line-height: 1.7;
      margin-bottom: 25px;
      max-width: 480px;
    }

    .steps-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-bottom: 28px;
    }

    .step-box {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      padding: 13px;
      border-radius: 14px;
      transition: transform 0.2s ease;
    }

    .step-box:hover {
      transform: translateY(-3px);
    }

    .step-box span {
      font-size: 0.67rem;
      font-weight: 800;
      color: var(--blue);
      display: block;
      margin-bottom: 4px;
    }

    .step-box p {
      font-size: 0.78rem;
      font-weight: 600;
      color: #1e293b;
      margin: 0;
      line-height: 1.35;
    }

    .btn-exchange {
      background: var(--navy);
      color: #ffffff;
      text-decoration: none;
      font-weight: 700;
      font-size: 0.88rem;
      padding: 13px 23px;
      border-radius: 11px;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      width: fit-content;
      transition: all 0.25s ease;
    }

    .btn-exchange:hover {
      background: var(--blue);
      transform: translateY(-2px);
    }

    /* =====================================================
       PERKS
    ===================================================== */

    .perks-list {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .perk-row-item {
      background: #ffffff;
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 21px;
      display: flex;
      align-items: center;
      gap: 17px;
      transition: all 0.25s ease;
    }

    .perk-row-item:hover {
      transform: translateX(6px);
      border-color: #bfdbfe;
      box-shadow: 0 10px 25px rgba(15, 23, 42, 0.06);
    }

    .perk-badge {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      flex-shrink: 0;
    }

    .perk-badge.indigo {
      background: #eef2ff;
      color: #4f46e5;
    }

    .perk-badge.amber {
      background: #fef3c7;
      color: #d97706;
    }

    .perk-badge.emerald {
      background: #ecfdf5;
      color: #059669;
    }

    .perk-info h5 {
      font-size: 0.96rem;
      font-weight: 800;
      color: var(--navy);
      margin-bottom: 4px;
    }

    .perk-info p {
      font-size: 0.82rem;
      color: var(--muted);
      line-height: 1.45;
      margin: 0;
    }

    /* =====================================================
       CTA
    ===================================================== */

    .catalog-cta-strip {
      background:
        radial-gradient(circle at 85% 20%, rgba(255,255,255,0.18), transparent 30%),
        linear-gradient(135deg, #172554, #1d4ed8 55%, #3b82f6);
      border-radius: 25px;
      padding: 40px 44px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      color: #ffffff;
      margin-bottom: 90px;
      box-shadow: 0 20px 40px rgba(37, 99, 235, 0.22);
    }

    .cta-text-side h3 {
      font-family: var(--serif);
      font-size: 1.9rem;
      font-weight: 800;
      margin-bottom: 7px;
    }

    .cta-text-side p {
      font-size: 0.94rem;
      color: #dbeafe;
    }

    .btn-cta-light {
      background: #ffffff;
      color: var(--blue-dark);
      font-weight: 800;
      font-size: 0.9rem;
      padding: 14px 27px;
      border-radius: 12px;
      text-decoration: none;
      white-space: nowrap;
      transition: all 0.25s ease;
      box-shadow: 0 7px 20px rgba(0, 0, 0, 0.12);
    }

    .btn-cta-light:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 25px rgba(0, 0, 0, 0.16);
    }

    /* =====================================================
       FOOTER - KEPT SAME
    ===================================================== */

    .site-footer {
      background-color: var(--blue);
      color: #ffffff;
      padding: 24px 36px 18px;
      margin-top: auto;
    }

    .footer-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
    }

    .footer-brand {
      font-size: 1.3rem;
      font-weight: 800;
    }

    .footer-links {
      display: flex;
      gap: 20px;
    }

    .footer-links a {
      color: #ffffff;
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 600;
      transition: opacity 0.15s;
    }

    .footer-links a:hover {
      opacity: 0.8;
    }

    .footer-copy {
      text-align: center;
      font-size: 0.82rem;
      color: rgba(255, 255, 255, 0.8);
      border-top: 1px solid rgba(255, 255, 255, 0.18);
      padding-top: 14px;
    }

    /* =====================================================
       ANIMATION
    ===================================================== */

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(18px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* =====================================================
       RESPONSIVE
    ===================================================== */

    @media (max-width: 920px) {

      .hero-section {
        grid-template-columns: 1fr;
        text-align: center;
        padding: 55px 0 70px;
      }

      .hero-description {
        margin: 0 auto 28px;
      }

      .hero-actions {
        justify-content: center;
      }

      .hero-media {
        max-width: 650px;
        width: 100%;
        margin: 10px auto 0;
      }

      .hero-img {
        height: 350px;
      }

      .floating-glass-card {
        left: 20px;
      }

      .category-grid {
        grid-template-columns: 1fr;
      }

      .exchange-block {
        grid-template-columns: 1fr;
      }

      .catalog-cta-strip {
        flex-direction: column;
        text-align: center;
      }
    }

    @media (max-width: 650px) {

      .site-header {
        padding: 14px 18px;
        flex-direction: column;
        gap: 12px;
      }

      .site-nav {
        gap: 13px;
        flex-wrap: wrap;
        justify-content: center;
      }

      .site-nav a {
        font-size: 0.8rem;
      }

      .content-wrap {
        padding: 0 17px;
      }

      .hero-title {
        font-size: 2.8rem;
      }

      .hero-actions {
        flex-direction: column;
        width: 100%;
      }

      .btn-primary,
      .btn-outline {
        width: 100%;
        justify-content: center;
      }

      .hero-img {
        height: 280px;
        border-radius: 20px;
      }

      .hero-media::before {
        display: none;
      }

      .section-title {
        font-size: 2rem;
      }

      .exchange-banner-card {
        padding: 27px 22px;
      }

      .exchange-banner-card h3 {
        font-size: 1.9rem;
      }

      .steps-row {
        grid-template-columns: 1fr;
      }

      .catalog-cta-strip {
        padding: 30px 22px;
      }

      .cta-text-side h3 {
        font-size: 1.6rem;
      }

      .btn-cta-light {
        width: 100%;
        text-align: center;
      }

      .site-footer {
        padding: 22px 18px 17px;
      }
    }
  </style>
</head>

<body>

  <!-- HEADER - SAME -->
  <header class="site-header">
    <a href="/" class="site-logo">Bookstore</a>

    <nav class="site-nav">
      <a href="/" class="active">Home</a>
      <a href="/books">Books</a>
      <a href="/categories">Categories</a>
      <a href="/cart">Cart</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a href="/admin">Admin</a>
    </nav>
  </header>


  <main class="home-content">

    <div class="content-wrap">

      <!-- HERO -->
      <section class="hero-section">

        <div class="hero-text-side">

          <span class="badge-pill">
            Find Your Next Book
          </span>

          <h1 class="hero-title">
            Find stories that
            <br>
            <span>stay with you.</span>
          </h1>

          <p class="hero-description">
            Browse our collection of books, from fascinating stories
            to useful reads. Discover something worth reading,
            whether you're here to escape, learn, or simply enjoy
            a great story.
          </p>

          <div class="hero-actions">

            <a href="/books" class="btn-primary">
              Explore Books →
            </a>

            <a href="/about" class="btn-outline">
              Our Story
            </a>

          </div>

        </div>


        <div class="hero-media">

          <img
            src="https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?auto=format&fit=crop&w=1000&q=85"
            alt="Curated Books Collection"
            class="hero-img"
          >

          <div class="floating-glass-card">

            <div class="glass-tag">
              A World of Imagination
            </div>

            <p class="glass-text">
              One book at a time.
            </p>

          </div>

        </div>

      </section>


      <!-- CATEGORY SECTION -->
      <section>

        <div class="section-header">

          <h2 class="section-title">
            Explore by Category
          </h2>

          <p class="section-subtitle">
            Whatever you love to read, there is something here for you.
          </p>

        </div>


        <div class="category-grid">

          <a href="/category/Literary%20Fiction" class="category-item">

            <div class="cat-icon-wrap blue">
              📖
            </div>

            <div class="cat-details">

              <h4>
                LITERARY FICTION
              </h4>

              <p>
                Stories that move and inspire
              </p>

            </div>

            <span class="cat-arrow-icon">
              →
            </span>

          </a>


          <a href="/category/Fantasy" class="category-item">

            <div class="cat-icon-wrap green">
              🪄
            </div>

            <div class="cat-details">

              <h4>
                FANTASY
              </h4>

              <p>
                Magical worlds and adventures
              </p>

            </div>

            <span class="cat-arrow-icon">
              →
            </span>

          </a>


          <a href="/category/Finance" class="category-item">

            <div class="cat-icon-wrap amber">
              📈
            </div>

            <div class="cat-details">

              <h4>
                FINANCE
              </h4>

              <p>
                Money, mindset, and wealth
              </p>

            </div>

            <span class="cat-arrow-icon">
              →
            </span>

          </a>

        </div>

      </section>


      <!-- EXCHANGE -->
      <section class="exchange-block">

        <div class="exchange-banner-card">

          <div>

            <span class="exchange-tag-pill">
              🔄 Reader Exchange
            </span>

            <h3>
              Read. Swap. Repeat.
            </h3>

            <p>
              Done with your current shelf? Exchange your pre-read
              books with other members or trade them in for store
              credits on new arrivals.
            </p>


            <div class="steps-row">

              <div class="step-box">

                <span>
                  STEP 01
                </span>

                <p>
                  Bring or ship your used book
                </p>

              </div>


              <div class="step-box">

                <span>
                  STEP 02
                </span>

                <p>
                  Get instant verified credits
                </p>

              </div>


              <div class="step-box">

                <span>
                  STEP 03
                </span>

                <p>
                  Pick your next read for less
                </p>

              </div>

            </div>

          </div>


          <a href="/books" class="btn-exchange">
            Explore Exchange Shelf →
          </a>

