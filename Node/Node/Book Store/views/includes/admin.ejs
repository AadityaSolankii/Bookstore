      <p class="text-slate-600 mb-4">Upload a new book listing to the store catalog.</p>
      <a href="/books/add" class="inline-block px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700">Add Book</a>
    </div>
  </div>
</main>

