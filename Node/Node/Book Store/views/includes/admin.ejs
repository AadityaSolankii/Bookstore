<main class="max-w-4xl mx-auto my-12 px-4">
  <h1 class="text-3xl font-bold text-slate-900 mb-6">Admin Panel</h1>
  
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="p-6 bg-white rounded-xl shadow-md border border-slate-200">
      <h2 class="text-xl font-bold text-slate-800 mb-2">Book Inventory</h2>
      <p class="text-slate-600 mb-4">Edit prices, titles, or delete existing inventory.</p>
      <a href="/books" class="inline-block px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">Manage Books</a>
