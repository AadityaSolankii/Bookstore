<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Categories | Bookstore</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

  <!-- Matching Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,600;0,8..60,700;0,8..60,800&display=swap" rel="stylesheet">

  <style>
    :root {
      --brand-blue: #2563eb;
      --brand-blue-hover: #1d4ed8;
      --font-serif: 'Source Serif 4', Georgia, serif;
      --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    }

    body {
      font-family: var(--font-sans);
    }

    .serif-title {
      font-family: var(--font-serif);
    }

    /* Matching Header Styles */
    .site-header {
      background-color: var(--brand-blue);
      color: #ffffff;
      padding: 16px 36px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 50;
      box-shadow: 0 2px 10px rgba(37, 99, 235, 0.15);
    }

    .site-logo {
      font-size: 1.4rem;
      font-weight: 800;
      color: #ffffff;
      text-decoration: none;
      letter-spacing: -0.01em;
    }

    .site-nav {
      display: flex;
      gap: 24px;
      align-items: center;
    }

    .site-nav a {
      color: rgba(255, 255, 255, 0.9);
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 600;
      transition: color 0.15s ease;
    }

    .site-nav a:hover,
    .site-nav a.active {
      color: #ffffff;
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    /* Matching Footer Styles */
    .site-footer {
      background-color: var(--brand-blue);
      color: #ffffff;
      padding: 24px 36px 18px;
      margin-top: auto;
    }

    .footer-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
    }

    .footer-brand {
      font-size: 1.3rem;
      font-weight: 800;
    }

    .footer-links a {
      color: #ffffff;
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 600;
      transition: opacity 0.15s;
    }

    .footer-links a:hover {
      opacity: 0.8;
    }

    .footer-copy {
      text-align: center;
      font-size: 0.82rem;
      color: rgba(255, 255, 255, 0.8);
      border-top: 1px solid rgba(255, 255, 255, 0.18);
      padding-top: 14px;
    }
  </style>
</head>

<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

  <!-- Matching Navbar Header -->
  <header class="site-header">
    <a href="/" class="site-logo">Bookstore</a>
    <nav class="site-nav">
      <a href="/">Home</a>
      <a href="/books">Books</a>
      <a href="/category" class="active">Categories</a>
      <a href="/cart">Cart</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a href="/admin">Admin</a>
    </nav>
  </header>

  <!-- Categories Page Content -->
  <main class="max-w-6xl mx-auto px-5 py-12 flex-1 w-full">

    <!-- Heading -->
    <div class="mb-10 text-center">
      <span class="inline-block text-blue-600 font-bold uppercase tracking-wider text-xs bg-blue-50 border border-blue-100 px-3.5 py-1 rounded-full mb-3">
        Browse By Genre
      </span>
      <h1 class="serif-title text-4xl font-bold text-slate-900">
        Categories
      </h1>
      <p class="text-slate-500 mt-2 text-base">
        Explore your favorite books grouped by genre and topics.
      </p>
    </div>

    <%
      const selectedCategory = typeof category !== 'undefined' ? category : 'All';
      // Server se aayi hui dynamic list use karega ya fallback filter
      const categoryLinks = (typeof categories !== 'undefined' && categories.length)
        ? ['All', ...categories.filter(c => c && c.trim())]
        : ['All', 'Self learning', 'Fantasy', 'Literary Fiction', 'Finance'];
    %>

    <!-- Category Filter Pills -->
    <div class="mb-10 flex flex-wrap gap-2.5 justify-center">
      <% categoryLinks.forEach(cat => { %>
        <% const href = cat === 'All' ? '/category' : `/category/${encodeURIComponent(cat)}`; %>
        <a href="<%= href %>"
           class="px-5 py-2 rounded-full border text-sm font-semibold transition-all shadow-xs <%= (selectedCategory.toLowerCase() === cat.toLowerCase() || (selectedCategory === 'All' && cat === 'All')) ? 'bg-blue-600 text-white border-blue-600 shadow-sm' : 'bg-white text-slate-700 border-slate-200 hover:border-blue-400 hover:text-blue-600' %>">
          <%= cat %>
        </a>
      <% }) %>
    </div>

    <!-- Books List -->
    <% if (books && books.length) { %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <% books.forEach(book => { %>
          <div class="bg-white rounded-2xl shadow-xs border border-slate-200/80 hover:shadow-lg transition-all duration-300 p-4 flex items-center gap-5 hover:-translate-y-0.5">
            <img src="/<%= book.image %>"
                 alt="<%= book.name || book.title || 'Book image' %>"
                 class="w-24 h-32 md:w-28 md:h-36 object-contain rounded-xl border border-slate-100 bg-slate-50 p-1 flex-shrink-0">

            <div class="flex-1 min-w-0">
              <span class="inline-block text-[11px] font-bold uppercase tracking-wider text-blue-600 bg-blue-50 px-2.5 py-0.5 rounded-full mb-1.5">
                <%= book.category || 'General' %>
              </span>
              <h2 class="text-xl font-bold text-slate-900 mb-1.5 truncate" title="<%= book.name %>">
                <%= book.name %>
              </h2>
              <p class="text-lg font-bold text-blue-600 mb-1">
                ₹<%= book.price %>
              </p>
              <div class="flex items-center gap-3 pt-1">
                <a href="/books/add-to-cart/<%= book._id %>"
                   class="text-xs font-semibold bg-blue-600 hover:bg-blue-700 text-white px-3.5 py-1.5 rounded-lg transition">
                  Add to Cart
                </a>
                <a href="/books/edit/<%= book._id %>"
                   class="text-xs font-semibold text-slate-600 hover:text-blue-600 transition">
                  Edit Details →
                </a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="bg-white rounded-2xl border border-dashed border-slate-300 p-12 text-center text-slate-500">
        <p class="text-lg font-medium text-slate-700 mb-1">No books found in this category.</p>
        <p class="text-sm">Try choosing another genre or browse the full collection.</p>
      </div>
    <% } %>

  </main>

  <!-- Matching Footer (Only Email) -->
  <footer class="site-footer">
    <div class="footer-top">
      <span class="footer-brand">Bookstore</span>
      <div class="footer-links">
        <a href="mailto:support@bookstore.com">Email</a>
      </div>
    </div>
    <div class="footer-copy">
      &copy; 2026 Bookstore. All Rights Reserved.
    </div>
  </footer>

</body>
</html>