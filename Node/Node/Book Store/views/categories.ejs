<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Categories | Bookstore</title>

  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,600;0,8..60,700;0,8..60,800&display=swap" rel="stylesheet">

  <style>
    :root {
      --brand-blue: #2563eb;
      --brand-blue-hover: #1d4ed8;
      --font-serif: 'Source Serif 4', Georgia, serif;
      --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    }

    body {
      font-family: var(--font-sans);
    }

    .serif-title {
      font-family: var(--font-serif);
    }

    .site-header {
      background-color: var(--brand-blue);
      color: #ffffff;
      padding: 16px 36px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 50;
      box-shadow: 0 2px 10px rgba(37, 99, 235, 0.15);
    }

    .site-logo {
      font-size: 1.4rem;
      font-weight: 800;
      color: #ffffff;
      text-decoration: none;
      letter-spacing: -0.01em;
    }

    .site-nav {
      display: flex;
      gap: 24px;
      align-items: center;
    }

    .site-nav a {
      color: rgba(255, 255, 255, 0.9);
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 600;
      transition: color 0.15s ease;
    }

    .site-nav a:hover,
    .site-nav a.active {
      color: #ffffff;
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    .site-footer {
      background-color: var(--brand-blue);
      color: #ffffff;
      padding: 24px 36px 18px;
      margin-top: auto;
    }

    .footer-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
    }

    .footer-brand {
      font-size: 1.3rem;
      font-weight: 800;
    }

    .footer-links a {
      color: #ffffff;
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 600;
      transition: opacity 0.15s;
    }

    .footer-links a:hover {
      opacity: 0.8;
    }

    .footer-copy {
      text-align: center;
      font-size: 0.82rem;
      color: rgba(255, 255, 255, 0.8);
      border-top: 1px solid rgba(255, 255, 255, 0.18);
      padding-top: 14px;
    }
  </style>
</head>

<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

  <header class="site-header">
    <a href="/" class="site-logo">Bookstore</a>
    <nav class="site-nav">
      <a href="/">Home</a>
      <a href="/books">Books</a>
      <a href="/category" class="active">Categories</a>
      <a href="/cart">Cart</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a href="/admin">Admin</a>
    </nav>
  </header>

  <main class="max-w-6xl mx-auto px-5 py-12 flex-1 w-full">

    <div class="mb-10 text-center">
      <span class="inline-block text-blue-600 font-bold uppercase tracking-wider text-xs bg-blue-50 border border-blue-100 px-3.5 py-1 rounded-full mb-3">
        Browse By Genre
      </span>
      <h1 class="serif-title text-4xl font-bold text-slate-900">
        Categories
      </h1>
      <p class="text-slate-500 mt-2 text-base">
        Explore your favorite books grouped by genre and topics.
      </p>
    </div>

    <%
      const selectedCategory = typeof category !== 'undefined' ? category : 'All';
      // Server se aayi hui dynamic list use karega ya fallback filter
      const categoryLinks = (typeof categories !== 'undefined' && categories.length)
        ? ['All', ...categories.filter(c => c && c.trim())]
        : ['All', 'Self learning', 'Fantasy', 'Literary Fiction', 'Finance'];
    %>

    <div class="mb-10 flex flex-wrap gap-2.5 justify-center">
      <% categoryLinks.forEach(cat => { %>
      <% 
      const baseCategoryPath =
        (typeof isAdmin !== 'undefined' && isAdmin)
            ? '/admin/category'
            : '/category';

      const href = cat === 'All'
        ? baseCategoryPath
        : `${baseCategoryPath}/${encodeURIComponent(cat)}`;
        %>
        <a href="<%= href %>"
           class="px-5 py-2 rounded-full border text-sm font-semibold transition-all shadow-xs <%= (selectedCategory.toLowerCase() === cat.toLowerCase() || (selectedCategory === 'All' && cat === 'All')) ? 'bg-blue-600 text-white border-blue-600 shadow-sm' : 'bg-white text-slate-700 border-slate-200 hover:border-blue-400 hover:text-blue-600' %>">
          <%= cat %>
        </a>
      <% }) %>
    </div>

    <% if (books && books.length) { %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <% books.forEach(book => { %>
          <div class="bg-white rounded-2xl shadow-xs border border-slate-200/80 hover:shadow-lg transition-all duration-300 p-4 flex items-center gap-5 hover:-translate-y-0.5">
            <img src="/<%= book.image %>"
                 alt="<%= book.name || book.title || 'Book image' %>"
                 class="w-24 h-32 md:w-28 md:h-36 object-contain rounded-xl border border-slate-100 bg-slate-50 p-1 flex-shrink-0">

          <div class="flex-1 min-w-0">
              <span class="inline-block text-[11px] font-bold uppercase tracking-wider text-blue-600 bg-blue-50 px-2.5 py-0.5 rounded-full mb-1.5">
                <%= book.category || 'General' %>
              </span>
              <h2 class="text-xl font-bold text-slate-900 mb-1.5 truncate" title="<%= book.name %>">
                <%= book.name %>
              </h2>
              <p class="text-lg font-bold text-blue-600 mb-1">
                ₹<%= book.price %>
              </p>
              <div class="pt-2">
                <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                  <div class="flex items-center gap-2">
                    <!-- Edit Button -->
                    <a href="/books/edit/<%= book._id %>"
                       class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold text-amber-800 bg-amber-50 border border-amber-200 hover:bg-amber-100 hover:border-amber-300 transition shadow-xs">
                      <svg class="w-3.5 h-3.5 text-amber-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                      </svg>
                      <span>Edit Details</span>
                    </a>

                    <form action="/books/delete/<%= book._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this book?');" class="inline">
                      <button type="submit"
                              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold text-rose-700 bg-rose-50 border border-rose-200 hover:bg-rose-100 hover:border-rose-300 transition shadow-xs cursor-pointer">
                        <svg class="w-3.5 h-3.5 text-rose-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                        </svg>
                        <span>Delete</span>
                      </button>
                    </form>
                  </div>
                <% } else { %>
                  <a href="/books/add-to-cart/<%= book._id %>"
                     class="group inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold text-white bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 shadow-sm shadow-blue-500/25 hover:shadow-md hover:shadow-blue-500/40 active:scale-[0.97] transition-all duration-200">
                    <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:rotate-[-6deg]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                    </svg>
                    <span>Add to Cart</span>
                  </a>
                <% } %>
              </div>
            </div>  
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="bg-white rounded-2xl border border-dashed border-slate-300 p-12 text-center text-slate-500">
        <p class="text-lg font-medium text-slate-700 mb-1">No books found in this category.</p>
        <p class="text-sm">Try choosing another genre or browse the full collection.</p>
      </div>
    <% } %>

  </main>

  <footer class="site-footer">
    <div class="footer-top">
      <span class="footer-brand">Bookstore</span>
      <div class="footer-links">
        <a href="mailto:support@bookstore.com">Email</a>
      </div>
    </div>
    <div class="footer-copy">
      &copy; 2026 Bookstore. All Rights Reserved.
    </div>
  </footer>

</body>
</html>